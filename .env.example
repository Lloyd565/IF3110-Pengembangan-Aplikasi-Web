# Salin menjadi .env (sudah ada di .gitignore) lalu isi nilainya. JANGAN commit .env.
#
# .env dimuat otomatis saat server start (jalankan dari root repo).
# Variabel environment yang sudah di-set di terminal tidak ditimpa.

# --- Wajib ---------------------------------------------------------------
# Database platform (users, groups, grants, sessions, migrations). Dari docker-compose: service platform-db.
PLATFORM_DATABASE_URL=postgres://platform:platform@localhost:5433/platform?sslmode=disable

# --- Server --------------------------------------------------------------
# Alamat listen (default :8080).
HTTP_ADDR=:8080
# development (default) | test | production. Pada production APP_ORIGIN, SESSION_KEY,
# dan ENCRYPTION_KEY wajib diisi dan cookie session memakai flag Secure.
APP_ENV=development
# Origin publik tanpa path; wajib https pada production. Contoh: https://dbplatform.example.com
APP_ORIGIN=http://localhost:8080

# --- Kunci rahasia (base64 dari tepat 32 byte) -----------------------------
# Buat nilai baru:
#   PowerShell 7 : [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   Git Bash     : openssl rand -base64 32
# Kunci penanda token CSRF. Kosong di development = acak tiap start (session lama tidak valid setelah restart).
SESSION_KEY=
# Kunci enkripsi password koneksi database target (AES-256-GCM). Wajib pada production.
# Jika berubah, semua koneksi yang sudah tersimpan tidak bisa didekripsi lagi.
ENCRYPTION_KEY=

# --- Admin pertama (opsional) -----------------------------------------------
# Dibuat saat startup HANYA jika belum ada satu pun Platform Admin. Password minimal 8 karakter.
# Hapus kedua baris ini dari .env setelah akun terbuat.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Kebijakan session (opsional, durasi Go; nilai di bawah adalah default) ---
# SESSION_IDLE_TIMEOUT=30m
# SESSION_ABSOLUTE_TTL=8h
# SESSION_ROTATION_INTERVAL=15m
# SESSION_GRACE_PERIOD=30s

# --- Test integration ------------------------------------------------------
# Server Postgres untuk test (test membuat database sementara it_* sendiri). Dari docker-compose: test-db.
# Jika kosong, test integration dilewati (SKIP).
TEST_DATABASE_URL=postgres://test:test@localhost:5435/test?sslmode=disable

# --- Contoh koneksi target untuk didaftarkan lewat halaman Admin Koneksi ---------
# Dari docker-compose: service target-db (berisi data contoh).
#   host: localhost   port: 5434   database: target   username: target   password: target   sslmode: disable
