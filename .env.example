# Database platform
PLATFORM_DATABASE_URL=postgres://platform:platform@localhost:5433/platform?sslmode=disable

# Alamat server
HTTP_ADDR=:8080

# development | test | production
APP_ENV=development

# Origin publik
APP_ORIGIN=http://localhost:8080

# Token CSRF (openssl rand -base64 32)
SESSION_KEY=

# Enkripsi password koneksi (openssl rand -base64 32)
ENCRYPTION_KEY=

# Admin pertama
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=12345678

# Session (opsional)
# SESSION_IDLE_TIMEOUT=30m
# SESSION_ABSOLUTE_TTL=8h
# SESSION_ROTATION_INTERVAL=15m
# SESSION_GRACE_PERIOD=30s

# Database test
TEST_DATABASE_URL=postgres://test:test@localhost:5435/test?sslmode=disable

# Contoh koneksi target: localhost:5434, db/user/pass = target, sslmode disable
